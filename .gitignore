# ==================================================
# AVeriTeC data
# ==================================================

# Ignore all downloaded and generated files under data
AVeriTeC/data/*

# Keep the internal_split directory so that the two
# experimental ID records can remain version-controlled
!AVeriTeC/data/internal_split/

# Ignore everything inside internal_split first
AVeriTeC/data/internal_split/*

# Retain only the claim-index records used in the dissertation
!AVeriTeC/data/internal_split/dev_ids_200.json
!AVeriTeC/data/internal_split/test_ids_600.json

# Generated development and test evidence stores
AVeriTeC/evidence_store/


# ==================================================
