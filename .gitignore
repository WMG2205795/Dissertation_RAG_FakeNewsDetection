*.db
*.sqlite
*.sqlite3

# Dense vectors and model artifacts
*.npy
*.npz
*.pt
*.pth
*.bin
*.safetensors

# Lucene indexes, checkpoints and retrieval caches
checkpoint.json
merge_failed_files.txt


